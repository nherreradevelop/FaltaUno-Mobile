# FaltaUno - variables de entorno de la app móvil (copiar como .env; no se sube al repositorio)
# Las variables EXPO_PUBLIC_* quedan dentro de la app: nunca poner secretos acá.

# Opcional. Si está vacía, en desarrollo se usa la IP de la máquina donde corre Expo con el puerto 3000.
EXPO_PUBLIC_URL_API=

# Login con Google (Google Cloud Console). Vacías: no se muestra el botón de Google.
# Client ID de tipo "Aplicación web": Google lo usa como audiencia del ID token en Android e iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Client ID de tipo "iOS" (bundle uy.faltauno.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
